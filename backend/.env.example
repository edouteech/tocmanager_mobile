# API Configuration
PROJECT_NAME="TocManager API"
VERSION="1.0.0"
ENVIRONMENT="development"
ENABLE_DEMO_SEED=true
SECRET_KEY="replace-with-a-random-secret-key-min-32-chars-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=2880
REFRESH_TOKEN_EXPIRE_MINUTES=43200
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000"

# Initial production superadmin bootstrap (used only once when DB has no superadmin)
BOOTSTRAP_SUPERADMIN_USERNAME="admin"
# BOOTSTRAP_SUPERADMIN_EMAIL="admin@tocmanager.com"
# BOOTSTRAP_SUPERADMIN_PASSWORD="replace-with-strong-password"

# Database
# Default: SQLite
DATABASE_URL="sqlite:///./tocmanager.db"
# PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/tocmanager_db"
