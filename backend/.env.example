# API Configuration
PROJECT_NAME="TocManager API"
VERSION="1.0.0"
ENVIRONMENT="development"
ENABLE_DEMO_SEED=true
SECRET_KEY="replace-with-a-random-secret-key-min-32-chars-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=2880
REFRESH_TOKEN_EXPIRE_MINUTES=43200
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000"
# Production CORS example:
# BACKEND_CORS_ORIGINS="https://tocmanager.locarapide.com,https://admin.tocmanager.locarapide.com"

# Initial production superadmin bootstrap (used only once when DB has no superadmin)
BOOTSTRAP_SUPERADMIN_USERNAME="admin"
# BOOTSTRAP_SUPERADMIN_EMAIL="admin@tocmanager.com"
# BOOTSTRAP_SUPERADMIN_PASSWORD="replace-with-strong-password"

# Database
# Default: SQLite
DATABASE_URL="sqlite:///./tocmanager.db"
# PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/tocmanager_db"

# FeexPay REST v2 Billing
FEEXPAY_BASE_URL="https://api-v2.feexpay.me"
FEEXPAY_MODE="sandbox"
# FEEXPAY_API_KEY=""
# FEEXPAY_API_ID=""
# FEEXPAY_LIVE_API_KEY=""
# FEEXPAY_LIVE_API_ID=""
# PAYMENT_ENCRYPTION_KEY=""

# Object Storage — Cloudflare R2 / S3-compatible (local fallback in dev when unset)
# S3_ENDPOINT_URL="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_REGION="auto"
# S3_BUCKET="tocmanager-media"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL="https://media.tocmanager.locarapide.com"
LOCAL_UPLOAD_DIR="./uploads"

# Transactional Emails — Resend primary (optional SMTP / console fallback in dev)
# RESEND_API_KEY="re_replace_with_resend_key"
MAIL_FROM="TocManager <no-reply@tocmanager.locarapide.com>"
FRONTEND_BASE_URL="http://localhost:3000"
# Production example: FRONTEND_BASE_URL="https://tocmanager.locarapide.com"
# Optional SMTP fallback when RESEND_API_KEY is unset:
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASSWORD=""

# Observability — Sentry (optional)
# SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.1

# Automated PostgreSQL Backups to Cloudflare R2 / S3 (backend/scripts/backup_pg_to_s3.sh)
BACKUP_RETENTION_DAYS=30
# BACKUP_ENCRYPTION_PASSPHRASE="replace-with-strong-passphrase"
